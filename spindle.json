{
  "version": "1.0.0",
  "name": "Shutter",
  "identifier": "shutter",
  "author": "cfigure",
  "github": "https://github.com/cfigure/Lumiverse-Shutter",
  "homepage": "https://github.com/cfigure/Lumiverse-Shutter",
  "description": "Quick-access widget for ImageGen with configurable insert behaviour.",
  "permissions": ["chats", "chat_mutation", "ui_panels", "generation"],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "0.1.0",
  "storage_seed_files": [
    { "from": "defaults/settings.json", "to": "settings.json", "overwrite": false }
  ]
}
