{
  "version": "1.0.6",
  "name": "Shutter",
  "identifier": "shutter",
  "author": "cfigure",
  "github": "https://github.com/cfigure/Lumiverse-Shutter",
  "homepage": "https://github.com/cfigure/Lumiverse-Shutter",
  "description": "Quick-access widget for native Lumiverse ImageGen with configurable inline insertion automation.",
  "permissions": [
    "chat_mutation",
    "ui_panels",
    "interceptor",
    "app_manipulation"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "1.0.4",
  "storage_seed_files": [
    {
      "from": "defaults/settings.json",
      "to": "settings.json",
      "overwrite": false
    }
  ]
}
